# Вставьте ОДИН из вариантов в Streamlit Cloud → App → Settings → Secrets
# (локально — в .streamlit/secrets.toml). Без ключа работает офлайн-режим.

# Вариант 1 — Google Gemini (БЕСПЛАТНО): ключ на https://aistudio.google.com/apikey
OPENAI_API_KEY = "AIza..."
OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_MODEL = "gemini-2.5-flash"

# Вариант 2 — Groq (БЕСПЛАТНО): ключ на https://console.groq.com/keys
# OPENAI_API_KEY = "gsk_..."
# OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
# OPENAI_MODEL = "openai/gpt-oss-120b"

# Вариант 3 — OpenAI (платно): ключ на https://platform.openai.com/api-keys
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
